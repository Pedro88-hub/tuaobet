PORT=3000
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tuaobet?schema=public"
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"
# Emails promovidos a ADMIN ao arrancar (separados por vírgula)
# ADMIN_EMAILS=admin@exemplo.com
# Uma origem ou várias separadas por vírgula (CORS + Socket.IO)
FRONTEND_URL="http://localhost:5173,http://localhost:8080"
NODE_ENV=development

# Apostas: MIN_BET padrão 0.5 (R$ 0,50). MAX_BET opcional (teto fixo extra).
# Sem MAX_BET, o máximo por aposta é o saldo do jogador (debitStake).
# MIN_BET=0.5
# MAX_BET=10000

# Limite de pedidos /api/games/* por minuto por utilizador (padrão 60)
# GAMES_RATE_LIMIT_MAX=60

# Double — lista de apostas simuladas (apenas UI; não liquida). Desativar: 1 ou true
# DOUBLE_SIMULATOR_DISABLED=0
# Crash — mesma ideia que o Double (nomes/valores/janela de countdown). Desativar: 1 ou true
# CRASH_SIMULATOR_DISABLED=0
# Fuso para picos de “tráfego” simulado (padrão America/Sao_Paulo)
# DOUBLE_SIMULATOR_TZ=America/Sao_Paulo

# API-Football (api-sports.io) — desporto
# APISPORTS_FOOTBALL_KEY=
# Fuso para fixtures e queryDate na BD (padrão Brasil)
# APISPORTS_TIMEZONE=America/Sao_Paulo
# Ligas a guardar/listar: 71 Série A, 72 Série B, 73 Copa — ou all
# SPORTS_LEAGUE_IDS=71,72,73
