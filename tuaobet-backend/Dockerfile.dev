# Imagem para desenvolvimento: dependências fixas; código vem por volume (src + prisma).
FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache openssl

COPY package.json package-lock.json* ./
COPY prisma ./prisma/

RUN npm ci

COPY tsconfig.json ./
COPY src ./src

RUN npx prisma generate

EXPOSE 3000

CMD ["npm", "run", "dev"]
